# Required — Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/gigabee

# Required — random string, min 32 characters (used for session signing + HMAC receipts)
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Required — Helius RPC key for Solana mainnet (get free key at https://helius.dev)
HELIUS_API_KEY=your-helius-api-key

# Required — Solana wallet private key (base58) for the treasury wallet that collects credits
TREASURY_PRIVATE_KEY=your-base58-encoded-private-key

# Required — Secret token for admin routes (/api/admin/*)
ADMIN_TOKEN=change-me-to-a-random-admin-secret

# Optional — Ollama model overrides (defaults shown)
OLLAMA_HOST=http://localhost:11434
OLLAMA_HOVER_MODEL=llama3.2:3b
OLLAMA_GLIDE_MODEL=llama3.3:70b

# Optional — Log level (trace | debug | info | warn | error | fatal | silent)
LOG_LEVEL=info
